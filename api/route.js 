export default function handler(req, res) {
    if (req.method !== "POST") {
        return res.status(405).json({
            error: "Método no permitido"
        });
    }

    try {
        const { start, end } = req.body || {};

        if (
            !Array.isArray(start) ||
            !Array.isArray(end) ||
            start.length !== 2 ||
            end.length !== 2
        ) {
            return res.status(400).json({
                error: "Coordenadas inválidas"
            });
        }

        const apiKey = process.env.ORS_API_KEY;

        if (!apiKey) {
            return res.status(500).json({
                error: "ORS_API_KEY no está configurada en Vercel"
            });
        }

        const response = await fetch(
            "https://api.heigit.org/openrouteservice/v2/directions/driving-car",
            {
                method: "POST",
                headers: {
                    "Authorization": apiKey,
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({
                    coordinates: [
                        start,
                        end
                    ]
                })
            }
        );

        const text = await response.text();

let data;

try {
    data = JSON.parse(text);
} catch {
    data = {
        raw: text
    };
}

console.log("ORS STATUS:", response.status);
console.log("ORS DATA:", data);

        if (!response.ok) {
            console.error(
                "OpenRouteService:",
                response.status,
                data
            );

            return res.status(response.status).json({
                error:
                    data.error?.message ||
                    data.message ||
                    "OpenRouteService rechazó la solicitud."
            });
        }

        const distanceMeters =
            data.routes?.[0]?.summary?.distance;

        if (!Number.isFinite(distanceMeters)) {
            return res.status(500).json({
                error:
                    "OpenRouteService no devolvió una distancia."
            });
        }

        return res.status(200).json({
            distanceKm:
                distanceMeters / 1000
        });

    } catch (error) {

        console.error(
            "PanchGo API ROUTE ERROR:",
            error
        );

        return res.status(500).json({
            error:
                error.message ||
                "Error interno al calcular la ruta."
        });
    }
}
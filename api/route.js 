export default async function handler(request, response) {
  if (request.method !== "POST") {
    return response.status(405).json({
      error: "Método no permitido"
    });
  }

  try {
    const { start, end } = request.body;

    if (!Array.isArray(start) || !Array.isArray(end)) {
      return response.status(400).json({
        error: "Coordenadas inválidas"
      });
    }

    const apiKey = process.env.ORS_API_KEY;

    if (!apiKey) {
      return response.status(500).json({
        error: "Falta ORS_API_KEY"
      });
    }

    const orsResponse = await fetch(
      "https://api.heigit.org/openrouteservice/v2/directions/driving-car",
      {
        method: "POST",
        headers: {
          "Authorization": apiKey,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          coordinates: [start, end]
        })
      }
    );

    const orsData = await orsResponse.json();

    if (!orsResponse.ok) {
      console.error("ORS ERROR:", orsData);

      return response.status(502).json({
        error: "Error de OpenRouteService"
      });
    }

    const distanceMeters =
      orsData?.routes?.[0]?.summary?.distance;

    if (!Number.isFinite(distanceMeters)) {
      return response.status(502).json({
        error: "OpenRouteService no devolvió distancia"
      });
    }

    const distanceKm = distanceMeters / 1000;

    return response.status(200).json({
      distanceKm
    });

  } catch (error) {
    console.error("ROUTE ERROR:", error);

    return response.status(500).json({
      error: "Error interno al calcular la ruta"
    });
  }
}